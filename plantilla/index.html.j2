            <!-- corsé -->
            <path d="M44 44 Q51 38 60 46 Q69 38 76 44 L74 70 Q60 74 46 70 Z" fill="url(#bd)"/>
            <path d="M52 47 Q55 58 53 70 M68 47 Q65 58 67 70 M60 50 V72" stroke="#2d3b49" stroke-opacity=".5" stroke-width=".7" fill="none"/>
            <path d="M44 44 Q51 38 60 46 Q69 38 76 44" fill="none" stroke="#d3dee8" stroke-width="1"/>
            <!-- cinturón con broche -->
            <path d="M46 68 Q60 73 74 68 L74 73 Q60 78 46 73 Z" fill="#1d2731"/>
            <circle cx="60" cy="73" r="3" fill="#e7eef4" stroke="#8ea3b7" stroke-width=".6"/>
            <circle cx="60" cy="73" r="1.2" fill="#ffffff"/>
            <!-- destellos -->
            <circle cx="50" cy="56" r=".7" fill="#fff" opacity=".8"/><circle cx="70" cy="60" r=".7" fill="#fff" opacity=".8"/>
            <circle cx="40" cy="120" r=".8" fill="#fff" opacity=".6"/><circle cx="82" cy="132" r=".8" fill="#fff" opacity=".6"/><circle cx="62" cy="144" r=".8" fill="#fff" opacity=".6"/>
