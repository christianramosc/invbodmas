          <span class="sans">{{ c.vestimenta.etiqueta_vestido }}</span>
        </div>
      </div>{% endif %}
      {% if c.vestimenta.nota %}<p class="note">{{ c.vestimenta.nota }}</p>{% endif %}
{% endif %}{% if c.secciones.vestimenta and c.secciones.sin_ninos %}      <div class="divider"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z"/></svg></div>
{% endif %}{% if c.secciones.sin_ninos %}      <div class="adults">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 3h8M9 3v5a3 3 0 006 0V3M12 11v8M8.5 21h7"/></svg>
        <div class="sans">{{ c.textos.sin_ninos_titulo }}</div>
      </div>
      <p class="note">{{ c.textos.sin_ninos_nota }}</p>
{% endif %}    </div>
  </section>
{% endif %}

{% if c.secciones.galeria and d.galeria %}  <!-- GALERÍA -->
  <section class="alt">
    <div class="wrap">
      <div class="reveal">
        <div class="sans eyebrow">{{ c.textos.galeria_eyebrow }}</div>
        <h2 class="section-title gold-text">{{ c.textos.galeria_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
      </div>
      <div class="gallery reveal">
{% for g in d.galeria %}        <div class="ph-box" data-full="fotos/full/{{ g }}" style="transition-delay:{{ '%.2f'|format(loop.index0 * 0.11) }}s"><img class="ph" src="fotos/{{ g }}" alt="{{ c.novios.texto }}" loading="lazy"></div>
{% endfor %}      </div>
    </div>
  </section>
{% endif %}
{% if c.secciones.regalos and c.regalos %}  <!-- MESA DE REGALOS -->
  <section>
    <div class="wrap reveal">
      <div class="sans eyebrow">{{ c.textos.regalos_eyebrow }}</div>
      <h2 class="section-title gold-text">{{ c.textos.regalos_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
      <p class="note">{{ c.textos.regalos_nota }}</p>
      <div class="gift-grid" style="grid-template-columns:{{ '1fr' if c.regalos|length < 2 else 'repeat(auto-fit,minmax(240px,1fr))' }};max-width:{{ '380px' if c.regalos|length < 2 else '820px' }};margin-left:auto;margin-right:auto">
{% for r in c.regalos %}        <div class="gift">
          <div class="sans">{{ r.tienda }}</div>
          {% if r.numero %}<div class="sans" style="color:var(--muted);margin-top:.6rem">{{ r.etiqueta or 'Número de evento' }}</div>
          <div class="big" style="letter-spacing:.06em">{{ r.numero }}</div>{% endif %}
          {% if r.nota %}<p style="color:var(--muted);font-size:1.05rem;margin:.4rem 0 .8rem">{{ r.nota }}</p>{% endif %}
          {% if r.numero or r.enlace %}<div class="btn-row">
            {% if r.numero %}<button class="btn copy-gift" data-num="{{ r.numero }}" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="8" y="8" width="12" height="12" rx="1.5"/><path d="M16 8V5.5A1.5 1.5 0 0014.5 4h-9A1.5 1.5 0 004 5.5v9A1.5 1.5 0 005.5 16H8"/></svg>
              <span>{{ c.textos.copiar }}</span></button>{% endif %}
            {% if r.enlace %}<a class="btn" href="{{ r.enlace }}" target="_blank" rel="noopener">{{ r.boton or ('Ir a ' ~ r.tienda) }}</a>{% endif %}
          </div>{% endif %}
        </div>
{% endfor %}      </div>
    </div>
  </section>
{% endif %}
{% if c.secciones.confirmacion %}  <!-- CONFIRMACIÓN -->
  <section class="dark rsvp">
    <div class="wrap reveal">
      <div class="sans eyebrow">{{ c.textos.rsvp_eyebrow }}</div>
      <h2 class="section-title gold-text">{{ c.textos.rsvp_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
      <p class="deadline">{{ c.textos.rsvp_texto }}</p>
{% if d.limite_dia %}      <div class="limit-wrap reveal">
        <div class="lim-rule"><span></span><i></i><span></span></div>
        <div class="lim-eyebrow sans">{{ c.textos.limite_titulo }}</div>
        <div class="lim-date">{{ d.limite_dia }}</div>
        <div class="lim-year sans">{{ d.limite_anio }}</div>
        <div class="lim-rule"><span></span><i></i><span></span></div>
      </div>
{% endif %}      <div class="btn-row" style="flex-direction:column;align-items:center">
{% for p in c.contactos %}        <a class="btn solid rsvp-btn" data-tel="52{{ p.telefono|replace(' ','')|replace('-','') }}" target="_blank" rel="noopener" style="flex-direction:column;gap:.35rem;min-width:270px">
          <span style="display:flex;align-items:center;gap:.55rem"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z"/></svg> {{ c.textos.confirmar }} · {{ p.telefono_bonito }}</span>
          {% if p.nombre %}<span style="font-family:'Cormorant Garamond',serif;font-size:1.05rem;letter-spacing:.05em;text-transform:none;font-style:italic">con {{ p.nombre }}</span>{% endif %}</a>
{% endfor %}      </div>
    </div>
  </section>
{% endif %}
  <footer>
    <p class="thanks">{{ c.textos.gracias }}</p>
    <div class="sans" style="opacity:.6;margin-bottom:.4rem">{{ c.textos.firma }}</div>
    <div class="script gold-text">{{ c.novios.texto }}</div>
    <div class="sans" style="margin-top:.6rem">{{ d.fecha_corta }}{% if c.ciudad %} · {{ c.ciudad }}{% endif %}</div>
    {% if c.hashtag %}<div class="sans" style="margin-top:1.4rem;opacity:.8">{{ c.hashtag }}</div>{% endif %}
  </footer>
</main>

<script>
/* =========================================================
   CONFIGURACIÓN — cambia aquí los datos principales
   ========================================================= */
const CONFIG = {{ d.js_config|tojson }};
window.INV = CONFIG;

/* ---------- Pase personalizado por enlace ----------
   Ejemplo: index.html?invitado=Familia%20P%C3%A9rez&pases=4  */
const params = new URLSearchParams(location.search);
const invitado = params.get("invitado");
const pases = params.get("pases");
if (invitado) {
  document.getElementById("introGuest").textContent = invitado;
  document.getElementById("guestName").textContent = invitado;
  document.getElementById("passSection").style.display = "";
  if (pases) {
    document.getElementById("guestSeats").textContent = pases;
    document.getElementById("seatsLbl").textContent = pases === "1" ? CONFIG.textos.pase_singular : CONFIG.textos.pase_plural;
  } else {
    document.getElementById("guestSeats").parentElement.querySelectorAll(".seats,#seatsLbl").forEach(e=>e.style.display="none");
  }
}

/* ---------- Fotos: si aún no existen, muestra un recuadro elegante ---------- */
const camIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8h4l2-3h6l2 3h4v12H3z"/><circle cx="12" cy="13" r="4"/></svg>';
document.querySelectorAll("img.ph").forEach(img=>{
  const swap = ()=>{
    const d = document.createElement("div");
    d.className = "placeholder" + (img.classList.contains("photo") ? " photo" : "");
    d.innerHTML = camIcon + "<span>" + (img.dataset.label || "Tu foto aquí") + "</span>";
    img.replaceWith(d);
  };
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener("error", swap);
});

/* ---------- Música ---------- */
let audio = null;
const musicBtn = document.getElementById("musicBtn");
let usingSynth = false, synth = null;

function startMusic(){
  audio = document.getElementById("bgm");
  if (!audio) return;
  audio.volume = 0;
  if (CONFIG.inicioCancion) audio.addEventListener("loadedmetadata", ()=>{ try{ audio.currentTime = CONFIG.inicioCancion; }catch(e){} }, {once:true});
  const p = audio.play();
  let v = 0; const fade = setInterval(()=>{ v = Math.min(CONFIG.volumen, v + 0.05); audio.volume = v; if (v >= CONFIG.volumen) clearInterval(fade); }, 150);
  if (p && p.catch) p.then(()=>setPlaying(true)).catch(()=>setPlaying(false));
}
function setPlaying(on){ musicBtn.classList.toggle("playing", on); }

/* Melodía de respaldo (solo para la demo, si no hay musica.mp3) */
function startSynth(){
  usingSynth = true;
  const AC = window.AudioContext || window.webkitAudioContext; if(!AC) return;
  const ctx = new AC(); const master = ctx.createGain(); master.gain.value = .22;
  const delay = ctx.createDelay(); delay.delayTime.value = .32;
  const fb = ctx.createGain(); fb.gain.value = .32;
  delay.connect(fb); fb.connect(delay); delay.connect(master); master.connect(ctx.destination);
  const chords = [[60,64,67,72],[57,60,64,69],[53,57,60,65],[55,59,62,67]]; // C, Am, F, G
  const f = n => 440*Math.pow(2,(n-69)/12);
  let step = 0, timer;
  function note(n,t,len,vol){
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = "triangle"; o.frequency.value = f(n);
    g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(vol,t+.02); g.gain.exponentialRampToValueAtTime(.0008,t+len);
    o.connect(g); g.connect(master); g.connect(delay); o.start(t); o.stop(t+len+.05);
  }
  function tick(){
    const c = chords[Math.floor(step/8)%4], t = ctx.currentTime+.05;
    const pat = [0,1,2,3,2,1,2,3];
    note(c[pat[step%8]]+12, t, 1.6, .35);
    if (step%8===0) note(c[0]-12, t, 3.2, .4);
    step++;
  }
  timer = setInterval(tick, 330);
  synth = {ctx, timer, playing:true,
    pause(){ ctx.suspend(); this.playing=false; },
    play(){ ctx.resume(); this.playing=true; }};
  setPlaying(true);
}

musicBtn.addEventListener("click", ()=>{
  if (usingSynth && synth){ synth.playing ? synth.pause() : synth.play(); setPlaying(synth.playing); return; }
  audio = audio || document.getElementById("bgm"); if (!audio) return;
  if (audio.paused){ audio.play(); setPlaying(true); } else { audio.pause(); setPlaying(false); }
});

/* ---------- Abrir sobre ---------- */
const env = document.getElementById("envelope");
const intro = document.getElementById("intro");
let opened = false;
function finishIntro(){
  intro.classList.add("gone");
  document.body.classList.remove("locked");
  document.getElementById("main").classList.add("visible");
  if (CONFIG.musica) musicBtn.classList.add("show");
}
function openInvitation(){
  if (opened) return; opened = true;
  if (CONFIG.musica) startMusic();
  intro.classList.add("opening");
  if (window.env3d && window.env3d.ready){                 // sobre en 3D
    window.env3d.open(
      p => window.petalBurst && window.petalBurst(p.x, p.y),
      () => { finishIntro(); window.env3d.stop(); }
    );
    return;
  }
  env.classList.add("open");
  setTimeout(()=>{
    const r = env.getBoundingClientRect();
    window.petalBurst && window.petalBurst(r.left + r.width/2, r.top + r.height*0.35);
  }, 1300);
  setTimeout(()=> env.classList.add("out"), 2500);
  setTimeout(finishIntro, 3700);
}
window.openInvitation = openInvitation;
intro.addEventListener("keydown", e=>{ if((e.key==="Enter"||e.key===" ") && intro.classList.contains("has3d")) openInvitation(); });
// si el sobre 3D no carga a tiempo, se muestra el sobre clásico
setTimeout(()=> intro.classList.remove("loading3d"), 4500);
env.addEventListener("click", openInvitation);
env.addEventListener("keydown", e=>{ if(e.key==="Enter"||e.key===" ") openInvitation(); });

/* ---------- Copiar número de mesa de regalos ---------- */
document.querySelectorAll(".copy-gift").forEach(b=>{
  const lbl = b.querySelector("span"), txt = lbl.textContent;
  b.addEventListener("click", async ()=>{
    const num = b.dataset.num;
    try { await navigator.clipboard.writeText(num); }
    catch(e){ const t=document.createElement("textarea"); t.value=num; document.body.appendChild(t); t.select(); try{document.execCommand("copy");}catch(_){} t.remove(); }
    lbl.textContent = CONFIG.textos.copiado;
    window.toast && toast(CONFIG.textos.copiado_aviso);
    setTimeout(()=> lbl.textContent = txt, 2200);
  });
});

/* ---------- Visor de fotos ---------- */
(function(){
  const boxes = [...document.querySelectorAll(".gallery .ph-box")];
  const lb = document.getElementById("lightbox"), img = document.getElementById("lbImg"), cnt = document.getElementById("lbCount");
  if (!boxes.length || !lb) return;
  let i = 0, x0 = null;
  const show = n => { i = (n + boxes.length) % boxes.length; img.src = boxes[i].dataset.full; cnt.textContent = (i+1) + " / " + boxes.length; };
  boxes.forEach((b,n)=> b.addEventListener("click", ()=>{ show(n); lb.classList.add("show"); }));
  const close = ()=> lb.classList.remove("show");
  document.getElementById("lbClose").onclick = close;
  document.getElementById("lbPrev").onclick = e=>{ e.stopPropagation(); show(i-1); };
  document.getElementById("lbNext").onclick = e=>{ e.stopPropagation(); show(i+1); };
  lb.addEventListener("click", e=>{ if (e.target === lb) close(); });
  addEventListener("keydown", e=>{ if(!lb.classList.contains("show")) return;
    if(e.key==="Escape") close(); if(e.key==="ArrowLeft") show(i-1); if(e.key==="ArrowRight") show(i+1); });
  lb.addEventListener("touchstart", e=> x0 = e.touches[0].clientX, {passive:true});
  lb.addEventListener("touchend", e=>{ if(x0===null) return; const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx < 0 ? i+1 : i-1); x0 = null; });
})();

/* ---------- Detalles finos ---------- */
window.toast = function(msg){
  const t = document.getElementById("toast"); if (!t) return;
  t.textContent = msg; t.classList.add("show");
  clearTimeout(t._h); t._h = setTimeout(()=> t.classList.remove("show"), 2200);
};
// barra de lectura + paralaje suave de la portada
(function(){
  const bar = document.getElementById("progress"), pic = document.querySelector(".hero picture");
  const reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  let ticking = false;
  function upd(){
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = "scaleX(" + (max > 0 ? Math.min(1, scrollY / max) : 0) + ")";
    if (pic && !reduce && scrollY < innerHeight * 1.2) pic.style.transform = "translateY(" + (scrollY * .3) + "px)";
    ticking = false;
  }
  addEventListener("scroll", ()=>{ if (!ticking){ ticking = true; requestAnimationFrame(upd); } }, {passive:true});
  upd();
})();
// vibración muy ligera al tocar botones (Android)
document.addEventListener("click", e=>{ if (e.target.closest(".btn") && navigator.vibrate) navigator.vibrate(8); });
// archivo .ics para iPhone / Outlook
(function(){
  const b = document.getElementById("icsBtn"); if (!b) return;
  const z = iso => new Date(iso).toISOString().replace(/[-:]/g,"").split(".")[0] + "Z";
  const esc = t => String(t).replace(/\\/g,"\\\\").replace(/,/g,"\\,").replace(/;/g,"\\;").replace(/\n/g,"\\n");
  const url = location.href.split("?")[0];
  const ics = [
    "BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Invitacion//ES","CALSCALE:GREGORIAN","METHOD:PUBLISH",
    "BEGIN:VEVENT","UID:" + z(CONFIG.fechaEvento) + "-" + CONFIG.slug + "@invitacion","DTSTAMP:" + z(new Date().toISOString()),
    "DTSTART:" + z(CONFIG.fechaEvento),"DTEND:" + z(CONFIG.finEvento),
    "SUMMARY:" + esc(CONFIG.tituloEvento),
    "LOCATION:" + esc(CONFIG.lugarCalendario),
    "DESCRIPTION:" + esc(CONFIG.descripcionCalendario + "\n" + url),
    "URL:" + url,
    "BEGIN:VALARM","TRIGGER:-P1D","ACTION:DISPLAY","DESCRIPTION:" + esc("Mañana: " + CONFIG.tituloEvento),"END:VALARM",
    "END:VEVENT","END:VCALENDAR"].join("\r\n");
  b.href = URL.createObjectURL(new Blob([ics], {type:"text/calendar;charset=utf-8"}));
})();

/* ---------- Cuenta regresiva ---------- */
if (document.getElementById("cdD")) {
const target = new Date(CONFIG.fechaEvento).getTime();
const pad = n => String(n).padStart(2,"0");
function tickCountdown(){
  let diff = Math.max(0, target - Date.now());
  const d = Math.floor(diff/864e5); diff -= d*864e5;
  const h = Math.floor(diff/36e5); diff -= h*36e5;
  const m = Math.floor(diff/6e4); diff -= m*6e4;
  const s = Math.floor(diff/1e3);
  [[cdD,String(d)],[cdH,pad(h)],[cdM,pad(m)],[cdS,pad(s)]].forEach(([el,v])=>{
    if (el.textContent !== v){ el.textContent = v; el.classList.remove("tick"); void el.offsetWidth; el.classList.add("tick"); }
  });
}
tickCountdown(); setInterval(tickCountdown, 1000);
}

/* ---------- Calendario (Google Calendar) ---------- */
const toCal = iso => new Date(iso).toISOString().replace(/[-:]/g,"").split(".")[0]+"Z";
if (document.getElementById("calBtn")) document.getElementById("calBtn").href =
  "https://calendar.google.com/calendar/render?action=TEMPLATE" +
  "&text=" + encodeURIComponent(CONFIG.tituloEvento) +
  "&dates=" + toCal(CONFIG.fechaEvento) + "/" + toCal(CONFIG.finEvento) +
  "&location=" + encodeURIComponent(CONFIG.lugarCalendario) +
  "&details=" + encodeURIComponent("¡Te esperamos! " + location.href.split("?")[0]);

/* ---------- Confirmación por WhatsApp ---------- */
const cuantos = pases ? ` (${pases} ${pases==="1"?"persona":"personas"})` : "";
const msgSi = invitado
  ? `¡Hola! Confirmo con mucho gusto nuestra asistencia a ${CONFIG.eventoDe} ${CONFIG.novios}. Nombre: ${invitado}${cuantos}. 💍`
  : `¡Hola! Confirmo con mucho gusto mi asistencia a ${CONFIG.eventoDe} ${CONFIG.novios}. 💍\nMi nombre es: `;
document.querySelectorAll(".rsvp-btn").forEach(b=>{
  b.href = `https://wa.me/${b.dataset.tel}?text=${encodeURIComponent(msgSi)}`;
});

/* ---------- Animación al hacer scroll ---------- */
const io = new IntersectionObserver(entries=>{
  entries.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add("in"); io.unobserve(en.target); } });
},{threshold:.15});
document.querySelectorAll(".reveal").forEach(el=>io.observe(el));

/* ---------- Animación de fondo: pétalos blancos ---------- */
(function(){
  const fondoPet = CONFIG.efectos.fondo === 'petalos', aperturaPet = CONFIG.efectos.apertura === 'petalos';
  if (!fondoPet && !aperturaPet) return;
  const reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cv = document.getElementById("petals"), ctx = cv.getContext("2d");
  let W, H, dpr;
  function resize(){
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = cv.width = innerWidth * dpr; H = cv.height = innerHeight * dpr;
  }
  resize(); addEventListener("resize", resize);

  // Cada pétalo se dibuja una sola vez (con volumen, vena y sombra) y luego se reutiliza
  const TONES = [["#ffffff","#f2f5f8","#c5cfd9"],["#ffffff","#f7f5f1","#d5d0c8"],["#fdfefe","#e8edf2","#b3c0cd"]];
  function sprite(t, curl){
    const S = 128, c = document.createElement("canvas"); c.width = c.height = S;
    const g = c.getContext("2d"); g.translate(S/2, S/2);
    const w = S*.30, h = S*.40;
    const path = ()=>{ g.beginPath(); g.moveTo(0,h);
      g.bezierCurveTo(-w*1.3,h*.45,-w*1.2,-h*.8,-w*.3,-h*.97);
      g.quadraticCurveTo(0,-h*.72,w*.3,-h*.97);
      g.bezierCurveTo(w*1.2,-h*.8,w*1.3,h*.45,0,h); g.closePath(); };
    g.shadowColor = "rgba(30,42,55,.38)"; g.shadowBlur = 9; g.shadowOffsetY = 3;
    const rg = g.createRadialGradient(-w*.25,-h*.35,2,0,0,h*1.25);
    rg.addColorStop(0,t[0]); rg.addColorStop(.55,t[1]); rg.addColorStop(1,t[2]);
    path(); g.fillStyle = rg; g.fill();
    g.shadowColor = "transparent";
    g.save(); path(); g.clip();                       // sombra del doblez: da volumen
    const lg = g.createLinearGradient(-w*curl,0,w*curl,0);
    lg.addColorStop(0,"rgba(255,255,255,.35)"); lg.addColorStop(.55,"rgba(255,255,255,0)"); lg.addColorStop(1,"rgba(70,88,106,.28)");
    g.fillStyle = lg; g.fillRect(-S/2,-S/2,S,S);
    const bg = g.createLinearGradient(0,h*.3,0,h);     // base más oscura
    bg.addColorStop(0,"rgba(90,105,120,0)"); bg.addColorStop(1,"rgba(90,105,120,.3)");
    g.fillStyle = bg; g.fillRect(-S/2,-S/2,S,S);
    g.restore();
    path(); g.strokeStyle = "rgba(125,142,160,.5)"; g.lineWidth = 1; g.stroke();
    g.strokeStyle = "rgba(120,137,155,.45)"; g.lineWidth = 1;
    g.beginPath(); g.moveTo(0,h*.9); g.quadraticCurveTo(curl*w*.25,0,0,-h*.6); g.stroke();
    g.globalAlpha = .5; g.fillStyle = "#fff";
    g.beginPath(); g.ellipse(-w*.35*curl,-h*.3,w*.18,h*.3,-.3*curl,0,Math.PI*2); g.fill();
    return c;
  }
  const SPR = []; TONES.forEach(t=>{ SPR.push(sprite(t,1)); SPR.push(sprite(t,-1)); });

  function petal(x, y, burst){
    const z = burst ? .55 + Math.random()*.45 : Math.random();       // profundidad: 0 lejos, 1 cerca
    const ang = -Math.PI*(.08 + Math.random()*.84), spd = (3 + Math.random()*7) * dpr;
    return {
      x, y, z, size: (burst ? 22 + Math.random()*20 : 14 + z*26) * dpr,
      vx: burst ? Math.cos(ang)*spd : 0,
      vy: burst ? Math.sin(ang)*spd : (.3 + z*.85) * dpr,
      rot: Math.random()*Math.PI*2, vr: (Math.random()-.5)*(.012 + z*.02),
      flip: Math.random()*Math.PI*2, vf: .012 + Math.random()*.03,
      sway: Math.random()*Math.PI*2, vs: .008 + Math.random()*.016, amp: .3 + Math.random()*.7,
      a: burst ? 1 : .5 + z*.5, sp: SPR[Math.random()*SPR.length|0], burst, life: 1
    };
  }
  const ambient = [];
  const N = (reduce || !fondoPet) ? 0 : (innerWidth < 700 ? 20 : 36);
  for (let i=0;i<N;i++) ambient.push(petal(Math.random()*W, Math.random()*H, false));
  ambient.sort((a,b)=>a.z-b.z);                        // los cercanos se dibujan encima
  let bursts = [];
  window.petalBurst = function(cx, cy){
    if (reduce) return;
    for (let i=0;i<60;i++) bursts.push(petal(cx*dpr + (Math.random()-.5)*60*dpr, cy*dpr, true));
  };
  let fade = 1, wind = 0;
  function draw(p){
    const fx = Math.cos(p.flip), fy = .82 + .18*Math.sin(p.flip*.7);
    ctx.setTransform(1,0,0,1,p.x,p.y); ctx.rotate(p.rot);
    ctx.scale(Math.abs(fx) < .14 ? (fx < 0 ? -.14 : .14) : fx, fy);
    ctx.globalAlpha = p.a * Math.max(0,p.life) * fade * (.78 + .22*Math.abs(fx));
    ctx.drawImage(p.sp, -p.size/2, -p.size/2, p.size, p.size);
  }
  function step(p){
    p.sway += p.vs; p.flip += p.vf; p.rot += p.vr + Math.sin(p.sway)*.004;
    if (p.burst){
      p.vx = p.vx*.972 + wind*.02*dpr; p.vy = p.vy*.972 + .075*dpr;
      p.x += p.vx + Math.sin(p.sway)*.5*dpr; p.y += p.vy;
      if (p.vy > 0) p.life -= .0045;
    } else {
      p.x += (wind*(.35 + p.z*.9) + Math.sin(p.sway)*p.amp) * dpr;
      p.y += p.vy * (1 + .25*Math.cos(p.sway*1.3));     // cae a ritmo irregular, como una hoja
      if (p.x < -50*dpr) p.x = W + 40*dpr; else if (p.x > W + 50*dpr) p.x = -40*dpr;
      if (p.y > H + 30*dpr){
        if (window.petalsPaused){ p.y = H + 1e5; }        // no vuelve a caer mientras se ve el final
        else Object.assign(p, petal(Math.random()*W, -30*dpr, false), {z:p.z});
      }
      if (p.y > H + 5e4 && !window.petalsPaused){ Object.assign(p, petal(Math.random()*W, -30*dpr - Math.random()*H*.6, false), {z:p.z}); }
    }
  }
  function frame(now){
    fade = window.petalsPaused ? Math.max(0, fade - .03) : Math.min(1, fade + .02);
    wind = Math.sin(now*.00033)*.55 + Math.sin(now*.0011 + 2)*.3 + Math.sin(now*.0027)*.12;   // brisa con ráfagas
    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,W,H);
    for (const p of ambient){ step(p); draw(p); }
    bursts = bursts.filter(p => p.life > 0 && p.y < H + 60*dpr);
    for (const p of bursts){ step(p); draw(p); }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();

/* ---------- Fuegos artificiales al terminar de leer ---------- */
(function(){
  if (CONFIG.efectos.final !== 'fuegos') return;
  const reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  const footer = document.querySelector("footer");
  const cv = document.getElementById("fireworks");
  if (!footer || !cv || reduce) return;
  const ctx = cv.getContext("2d");
  let W, H, dpr;
  function resize(){
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = cv.width = innerWidth * dpr; H = cv.height = innerHeight * dpr;
  }
  resize(); addEventListener("resize", resize);
  // Paleta de la boda: blanco, plata y gris azulado
  const PALETTE = ["#ffffff","#eef3f7","#dfe7ee","#b3c1ce","#8fa3b7"];
  const pick = a => a[Math.random()*a.length|0];
  const GLOW = {};                                     // halo luminoso por color
  PALETTE.forEach(c=>{
    const s = document.createElement("canvas"); s.width = s.height = 64;
    const g = s.getContext("2d"), r = g.createRadialGradient(32,32,0,32,32,32);
    r.addColorStop(0,"#ffffff"); r.addColorStop(.18,c); r.addColorStop(.5,c+"55"); r.addColorStop(1,c+"00");
    g.fillStyle = r; g.fillRect(0,0,64,64); GLOW[c] = s;
  });
  const small = innerWidth < 700;

  // ---- Sonido de cada explosión (generado en el navegador, sin archivos) ----
  let actx = null, master = null, noiseBuf = null;
  function audio(){
    if (!actx){
      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return null;
      actx = new AC(); master = actx.createGain(); master.gain.value = .55; master.connect(actx.destination);
      noiseBuf = actx.createBuffer(1, actx.sampleRate*2, actx.sampleRate);
      const d = noiseBuf.getChannelData(0); for (let i=0;i<d.length;i++) d[i] = Math.random()*2 - 1;
    }
    if (actx.state === "suspended") actx.resume();
    return actx;
  }
  addEventListener("pointerdown", ()=> audio(), {once:true});      // el toque al sobre habilita el audio
  document.addEventListener("visibilitychange", ()=>{ if (actx) document.hidden ? actx.suspend() : actx.resume(); });
  function out(c, x){
    if (c.createStereoPanner){ const p = c.createStereoPanner(); p.pan.value = Math.max(-.8, Math.min(.8, (x/W)*2 - 1)); p.connect(master); return p; }
    return master;
  }
  function boomSound(x, big, crackle){
    if (!CONFIG.funciones.sonido_fuegos) return;
    const c = audio(); if (!c) return;
    const t = c.currentTime + .02, dest = out(c, x), vol = (.32 + Math.random()*.12) * (big ? 1.25 : 1);
    // golpe grave
    const o = c.createOscillator(), og = c.createGain();
    o.type = "sine"; o.frequency.setValueAtTime(120, t); o.frequency.exponentialRampToValueAtTime(38, t + .35);
    og.gain.setValueAtTime(0, t); og.gain.linearRampToValueAtTime(vol*.9, t + .008); og.gain.exponentialRampToValueAtTime(.001, t + .5);
    o.connect(og); og.connect(dest); o.start(t); o.stop(t + .55);
    // estallido con eco que se apaga
    const n = c.createBufferSource(), f = c.createBiquadFilter(), ng = c.createGain();
    n.buffer = noiseBuf; n.playbackRate.value = .8 + Math.random()*.4;
    f.type = "lowpass"; f.frequency.setValueAtTime(2600, t); f.frequency.exponentialRampToValueAtTime(220, t + 1.1);
    ng.gain.setValueAtTime(0, t); ng.gain.linearRampToValueAtTime(vol, t + .006); ng.gain.exponentialRampToValueAtTime(.001, t + 1.5);
    n.connect(f); f.connect(ng); ng.connect(dest); n.start(t, Math.random()); n.stop(t + 1.6);
    if (crackle) crackleSound(x, t + .55);
  }
  function crackleSound(x, t0){
    const c = audio(); if (!c) return;
    const dest = out(c, x);
    for (let i=0;i<14;i++){
      const t = t0 + Math.random()*.7, n = c.createBufferSource(), f = c.createBiquadFilter(), g = c.createGain();
      n.buffer = noiseBuf; f.type = "highpass"; f.frequency.value = 2500 + Math.random()*3000;
      g.gain.setValueAtTime(.16 + Math.random()*.12, t); g.gain.exponentialRampToValueAtTime(.001, t + .04);
      n.connect(f); f.connect(g); g.connect(dest); n.start(t, Math.random()*1.5); n.stop(t + .05);
    }
  }

  let rockets = [], sparks = [], flashes = [], running = false, showUntil = 0, nextLaunch = 0, finale = false;
  const G = .05;

  function launch(xf){
    const x = (xf !== undefined ? xf : .12 + Math.random()*.76) * W;
    const ty = (.12 + Math.random()*.3) * H;
    const vy = -Math.sqrt(2 * .1*dpr * (H - ty));
    rockets.push({x, y:H, px:x, py:H, vx:(Math.random()-.5)*1.1*dpr, vy, ty, c:pick(PALETTE), w:Math.random()*6});
  }
  function spark(x,y,vx,vy,c,o){
    sparks.push(Object.assign({x,y,px:x,py:y,vx,vy,c,life:1,decay:.012,drag:.966,g:G,w:1.7,tw:false,crackle:false,head:true}, o));
  }
  function explode(r){
    const types = ["peonia","peonia","anillo","sauce","crisantemo","doble"];
    const type = pick(types), c1 = r.c, c2 = pick(PALETTE);
    const n = Math.round(((small ? 55 : 85) + Math.random()*35) * (type==="sauce" ? .75 : 1));
    const power = (3.2 + Math.random()*2.4) * dpr;
    boomSound(r.x, power > 4.6*dpr || type==="doble", type==="crisantemo");
    flashes.push({x:r.x, y:r.y, life:1, c:c1});
    for (let i=0;i<n;i++){
      const a = (i/n)*Math.PI*2 + Math.random()*.12;
      if (type==="anillo"){
        spark(r.x,r.y,Math.cos(a)*power,Math.sin(a)*power*.55,c1,{decay:.013+Math.random()*.004});
      } else if (type==="sauce"){                       // largas colas que caen como sauce
        const sp = power*(.35+Math.random()*.65);
        spark(r.x,r.y,Math.cos(a)*sp,Math.sin(a)*sp,c1,{decay:.0058+Math.random()*.003,drag:.972,g:G*1.5,w:1.3,tw:true});
      } else if (type==="crisantemo"){                  // estalla y chisporrotea al apagarse
        const sp = power*(.3+Math.random()*.7);
        spark(r.x,r.y,Math.cos(a)*sp,Math.sin(a)*sp,c1,{decay:.011+Math.random()*.008,crackle:Math.random()<.35});
      } else if (type==="doble"){                       // corazón blanco y corona de color
        const inner = i%2===0, sp = power*(inner ? .45 : 1)*(.85+Math.random()*.15);
        spark(r.x,r.y,Math.cos(a)*sp,Math.sin(a)*sp,inner?"#ffffff":c2,{decay:.011+Math.random()*.006});
      } else {
        const sp = power*Math.sqrt(Math.random());
        spark(r.x,r.y,Math.cos(a)*sp,Math.sin(a)*sp,Math.random()<.8?c1:c2,{decay:.010+Math.random()*.011,tw:Math.random()<.3});
      }
    }
  }
  function frame(now){
    ctx.globalCompositeOperation = "destination-out";  // deja estela al desvanecer
    ctx.globalAlpha = 1; ctx.fillStyle = "rgba(0,0,0,.17)"; ctx.fillRect(0,0,W,H);
    ctx.globalCompositeOperation = "lighter"; ctx.lineCap = "round";

    if (now < showUntil && now >= nextLaunch){
      launch(); if (Math.random() < .4) launch();
      nextLaunch = now + 360 + Math.random()*520;
    }
    if (!finale && showUntil - now < 1500 && now < showUntil){      // gran final
      finale = true; [.18,.34,.5,.66,.82].forEach((f,i)=> setTimeout(()=>launch(f), i*110));
    }
    flashes = flashes.filter(f=>{                       // destello al estallar
      const sz = (110 + (1-f.life)*90) * dpr;
      ctx.globalAlpha = f.life*.3; ctx.drawImage(GLOW[f.c], f.x - sz/2, f.y - sz/2, sz, sz);
      f.life -= .14; return f.life > 0;
    });
    rockets = rockets.filter(r=>{
      r.px = r.x; r.py = r.y; r.w += .5;
      r.x += r.vx + Math.sin(r.w)*.35*dpr; r.y += r.vy; r.vy += .1*dpr;
      ctx.globalAlpha = .9; ctx.strokeStyle = r.c; ctx.lineWidth = 2.2*dpr;
      ctx.beginPath(); ctx.moveTo(r.px, r.py + 8*dpr); ctx.lineTo(r.x, r.y); ctx.stroke();
      const sz = 16*dpr; ctx.drawImage(GLOW[r.c], r.x - sz/2, r.y - sz/2, sz, sz);
      if (Math.random() < .7) spark(r.x, r.y + 6*dpr, (Math.random()-.5)*.8*dpr, (.4+Math.random())*dpr, "#dfe7ee", {decay:.05+Math.random()*.04, w:1, head:false, g:G*.5});
      if (r.vy >= -.6*dpr || r.y <= r.ty){ explode(r); return false; }
      return true;
    });
    const born = [];
    sparks = sparks.filter(p=>{
      p.px = p.x; p.py = p.y;
      p.vx *= p.drag; p.vy = p.vy*p.drag + p.g*dpr;
      p.x += p.vx; p.y += p.vy; p.life -= p.decay;
      if (p.life <= 0){
        if (p.crackle) for (let k=0;k<4;k++) born.push([p.x,p.y,(Math.random()-.5)*2.4*dpr,(Math.random()-.5)*2.4*dpr,"#ffffff",{decay:.06+Math.random()*.05,w:1.1,tw:true,g:G*.4}]);
        return false;
      }
      const a = p.tw ? p.life*(.35 + Math.random()*.65) : p.life;
      ctx.globalAlpha = Math.min(1, a*1.15); ctx.strokeStyle = p.c; ctx.lineWidth = p.w*dpr*(.5 + p.life*.6);
      ctx.beginPath(); ctx.moveTo(p.px, p.py); ctx.lineTo(p.x, p.y); ctx.stroke();
      if (p.head && p.life > .25){
        const sz = (5 + p.life*5) * dpr; ctx.globalAlpha = a*.45;
        ctx.drawImage(GLOW[p.c] || GLOW["#ffffff"], p.x - sz/2, p.y - sz/2, sz, sz);
      }
      return true;
    });
    born.forEach(b=> spark.apply(null, b));
    ctx.globalAlpha = 1;
    if (rockets.length || sparks.length || flashes.length || now < showUntil){ requestAnimationFrame(frame); }
    else { running = false; ctx.globalCompositeOperation = "source-over"; ctx.clearRect(0,0,W,H); }
  }
  function show(ms){
    const now = performance.now();
    showUntil = Math.max(showUntil, now + ms); finale = false;
    if (!running){ running = true; nextLaunch = now; requestAnimationFrame(frame); }
  }
  // Se lanzan solos al llegar al final; tocar el pie de página repite el espectáculo
  const fio = new IntersectionObserver(entries=>{
    entries.forEach(en=>{ if (en.isIntersecting){ show(8000); fio.unobserve(en.target); } });
  },{threshold:.6});
  fio.observe(footer);
  // Al llegar al final, los pétalos dejan de caer y solo quedan los fuegos artificiales
  const pio = new IntersectionObserver(entries=>{
    entries.forEach(en=> window.petalsPaused = en.isIntersecting);
  },{threshold:.15});
  pio.observe(footer);
  footer.addEventListener("click", ()=> show(5000));
})();
</script>
<script src="js/efectos.js" defer></script>
{% if c.funciones.sobre3d %}<script src="js/three.min.js" defer></script>
<script src="js/sobre3d.js" defer></script>
{% endif %}{% if c.musica.activa %}<audio id="bgm" preload="auto" loop src="musica.mp3"></audio>{% endif %}
