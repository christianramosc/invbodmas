<!-- Botón de música -->
{% if c.musica.activa %}<button id="musicBtn" aria-label="Pausar o reproducir música">
  <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</button>{% else %}<button id="musicBtn" style="display:none" aria-hidden="true"></button>{% endif %}


<div id="lightbox" aria-hidden="true">
  <button id="lbClose" aria-label="Cerrar">&times;</button>
  <button id="lbPrev" aria-label="Anterior">&#8249;</button>
  <img id="lbImg" alt="{{ c.novios.texto }}">
  <button id="lbNext" aria-label="Siguiente">&#8250;</button>
  <div id="lbCount" class="sans"></div>
</div>

<div id="toast" role="status" aria-live="polite"></div>

<!-- ================= CONTENIDO ================= -->
<main id="main">

  <!-- PORTADA -->
  <header class="hero">
    <picture><source media="(min-aspect-ratio: 1/1)" srcset="fotos/portada-h.jpg"><img class="photo ph" src="fotos/portada.jpg" alt="{{ c.novios.texto }}" data-label="Foto de portada" fetchpriority="high"></picture>
    <div class="hero-content">
      <div class="sans">{{ c.textos.hero_kicker }}</div>
      <h1 aria-label="{{ c.novios.texto }}" style="{{ d.h1_style }}">{{ d.h1_html|safe }}</h1>
      <div class="date">{{ d.fecha_hero }}</div>
      <div class="scroll-cue">
        <div class="sans cue-txt">Desliza</div>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dfe7ee" stroke-width="1.4"><path d="M6 9l6 6 6-6"/></svg>
      </div>
    </div>
  </header>

  <!-- FRASE -->
{% if c.secciones.frase %}  <section>
    <div class="wrap reveal">
      <p class="quote">“{{ c.frase.texto }}”{% if c.frase.autor %}
        <cite class="sans" style="color:var(--gold-dark)">{{ c.frase.autor }}</cite>{% endif %}</p>
    </div>
  </section>
{% endif %}
  <!-- PASE PERSONALIZADO (se llena con el enlace) -->
  <section class="alt" id="passSection" style="display:none">
    <div class="wrap reveal">
      <div class="pass">
        <div class="sans eyebrow">{{ c.textos.pase_para }}</div>
        <div class="name" id="guestName">Familia Pérez</div>
        <div class="divider"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 5.3 3.1 1.7-1.9 3.2-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg></div>
        <div class="sans eyebrow">{{ c.textos.pase_reservado }}</div>
        <div class="seats gold-text" id="guestSeats">4</div>
        <div class="sans" style="color:var(--muted);margin-top:.4rem" id="seatsLbl">{{ c.textos.pase_plural }}</div>
      </div>
    </div>
  </section>

  <!-- CUENTA REGRESIVA -->
{% if c.secciones.padres and c.familia %}  <!-- PADRES Y PADRINOS -->
  <section>
    <div class="wrap reveal">
      <div class="sans eyebrow">{{ c.textos.padres_eyebrow }}</div>
      <h2 class="section-title gold-text">{{ c.textos.padres_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
      <div class="parents" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
{% for g in c.familia %}        <div><span class="sans">{{ g.grupo }}</span><p>{% for n in g.nombres.replace(';', '\n').split('\n') if n.strip() %}{{ n.strip() }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p></div>
{% endfor %}      </div>
    </div>
  </section>
{% endif %}{% if c.secciones.cuenta_regresiva %}  <section class="dark">
    <div class="wrap reveal">
      <div class="sans eyebrow">{{ c.textos.cuenta_regresiva }}</div>
      <div class="countdown">
        <div class="cd-item"><div class="cd-num gold-text" id="cdD">00</div><div class="cd-lbl sans">Días</div></div>
        <div class="cd-item"><div class="cd-num gold-text" id="cdH">00</div><div class="cd-lbl sans">Horas</div></div>
        <div class="cd-item"><div class="cd-num gold-text" id="cdM">00</div><div class="cd-lbl sans">Min</div></div>
        <div class="cd-item"><div class="cd-num gold-text" id="cdS">00</div><div class="cd-lbl sans">Seg</div></div>
      </div>
      <div style="margin-top:2.2rem">
        <div class="sans" style="color:var(--gold-light);margin-bottom:1rem">{{ c.textos.guarden_fecha }}</div>
        <div class="btn-row">
          <a class="btn solid" id="calBtn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            Google Calendar
          </a>
          <a class="btn solid" id="icsBtn" href="#" download="{{ d.ics_nombre }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/></svg>
            iPhone / Outlook
          </a>
        </div>
      </div>
    </div>
  </section>
{% endif %}

  <!-- CEREMONIA Y RECEPCIÓN -->
{% if c.secciones.lugar or c.secciones.itinerario %}  <section class="alt">
    <div class="wrap">
{% if c.secciones.lugar %}      <div class="reveal">
        <div class="sans eyebrow">{{ c.textos.lugar_eyebrow }}</div>
        <h2 class="section-title gold-text">{{ c.textos.lugar_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
      </div>
      <div class="cards" style="grid-template-columns:{{ '1fr' if c.lugares|length < 2 else 'repeat(auto-fit,minmax(260px,1fr))' }};max-width:{{ '460px' if c.lugares|length < 2 else '920px' }};margin-left:auto;margin-right:auto">
{% for l in c.lugares %}        <div class="card reveal">
          <svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M24 44s14-12.4 14-24a14 14 0 10-28 0c0 11.6 14 24 14 24z"/><circle cx="24" cy="20" r="5"/><path d="M6 44h36"/></svg>
          <h3>{{ l.titulo }}</h3>
          {% if l.subtitulo %}<div class="sans" style="color:var(--muted);margin:.3rem 0 .9rem">{{ l.subtitulo }}</div>{% endif %}
          {% if l.hora %}<div class="time">{{ l.hora }}</div>{% endif %}
          <div class="place">{{ l.nombre }}</div>
          <div class="addr">{{ l.direccion }}</div>
          {% if l.mapa %}<a class="btn" href="{{ l.mapa }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>{{ c.textos.como_llegar }}</a>{% endif %}
        </div>
{% endfor %}      </div>
{% endif %}{% if c.secciones.itinerario and c.itinerario %}      <div style="margin-top:{{ '4rem' if c.secciones.lugar else '0' }}">
        <div class="reveal">
          <div class="sans eyebrow">{{ c.textos.itinerario_eyebrow }}</div>
          <h2 class="section-title gold-text">{{ c.textos.itinerario_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
        </div>
        <div class="itin reveal">
{% for it in c.itinerario %}{% set lado = 'l' if loop.index0 % 2 == 0 else 'r' %}          <div class="it it-{{ lado }} reveal" style="transition-delay:{{ '%.2f'|format(loop.index0 * 0.18) }}s">
            {% if lado == 'l' %}<div class="it-txt"><div class="it-time">{{ it.hora }}</div><div class="it-title sans">{{ it.titulo }}</div><div class="it-desc">{{ it.descripcion }}</div></div>{% else %}<div></div>{% endif %}
            <div class="it-ico">{{ iconos[it.icono]|safe if it.icono in iconos else iconos['anillos']|safe }}</div>
            {% if lado == 'r' %}<div class="it-txt"><div class="it-time">{{ it.hora }}</div><div class="it-title sans">{{ it.titulo }}</div><div class="it-desc">{{ it.descripcion }}</div></div>{% else %}<div></div>{% endif %}
          </div>
{% endfor %}        </div>
      </div>
{% endif %}    </div>
  </section>
{% endif %}
{% if c.secciones.hospedaje and c.hospedaje %}  <!-- HOSPEDAJE -->
  <section class="alt">
    <div class="wrap reveal">
      <div class="sans eyebrow">{{ c.textos.hospedaje_eyebrow }}</div>
      <h2 class="section-title gold-text">{{ c.textos.hospedaje_titulo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
      {% if c.textos.hospedaje_nota %}<p class="note">{{ c.textos.hospedaje_nota }}</p>{% endif %}
      <div class="gift-grid" style="grid-template-columns:{{ '1fr' if c.hospedaje|length < 2 else 'repeat(auto-fit,minmax(240px,1fr))' }};max-width:{{ '420px' if c.hospedaje|length < 2 else '860px' }};margin-left:auto;margin-right:auto">
{% for h in c.hospedaje %}        <div class="gift">
          <div class="sans">{{ h.nombre }}</div>
          {% if h.detalle %}<p style="color:var(--muted);font-size:1.05rem;margin:.5rem 0 .4rem">{{ h.detalle }}</p>{% endif %}
          {% if h.codigo %}<div class="sans" style="color:var(--muted);margin-top:.4rem">Código</div><div class="big" style="font-size:1.3rem;letter-spacing:.08em">{{ h.codigo }}</div>{% endif %}
          {% if h.telefono or h.enlace %}<div class="btn-row" style="margin-top:.8rem">
            {% if h.telefono %}<a class="btn" href="tel:{{ h.telefono }}">Llamar</a>{% endif %}
            {% if h.enlace %}<a class="btn" href="{{ h.enlace }}" target="_blank" rel="noopener">Reservar</a>{% endif %}
          </div>{% endif %}
        </div>
{% endfor %}      </div>
    </div>
  </section>
{% endif %}{% if c.secciones.vestimenta or c.secciones.sin_ninos %}  <section>
    <div class="wrap reveal">
{% if c.secciones.vestimenta %}      <div class="sans eyebrow">{{ c.textos.vestimenta_eyebrow }}</div>
      <h2 class="section-title gold-text">{{ c.vestimenta.codigo }}</h2>
        <div class="flourish" aria-hidden="true"><svg viewBox="0 0 160 22"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path class="fl" d="M70 11 C58 11 52 4 42 7 C35 9 36 16 42 15 C47 14 45 9 40 10 C30 12 20 11 6 11"/><path class="fl" d="M90 11 C102 11 108 4 118 7 C125 9 124 16 118 15 C113 14 115 9 120 10 C130 12 140 11 154 11"/></g><path class="fd" d="M80 6.5 L84.5 11 L80 15.5 L75.5 11 Z" fill="currentColor"/></svg></div>
{% if c.vestimenta.mostrar_figuras %}      <div class="dress">
        <div>
          <svg viewBox="0 26 120 144" class="outfit" aria-hidden="true">
            <defs>
              <linearGradient id="jk" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b434c"/><stop offset=".5" stop-color="#1d2228"/><stop offset="1" stop-color="#0e1114"/></linearGradient>
              <linearGradient id="lap" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5b6672"/><stop offset=".5" stop-color="#2a3139"/><stop offset="1" stop-color="#454f5a"/></linearGradient>
              <linearGradient id="sh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#dfe5ea"/></linearGradient>
            </defs>
            <!-- mangas -->
            <path d="M27 36 Q15 40 13 56 L9 140 Q9 146 15 146 L23 146 L27 70 Z" fill="url(#jk)"/>
            <path d="M93 36 Q105 40 107 56 L111 140 Q111 146 105 146 L97 146 L93 70 Z" fill="url(#jk)"/>
            <path d="M10 134 L24 134 M110 134 L96 134" stroke="#6f7b87" stroke-width=".8"/>
            <!-- camisa -->
            <path d="M44 32 L60 30 L76 32 L68 78 L60 84 L52 78 Z" fill="url(#sh)"/>
            <path d="M60 46 V84" stroke="#c9d1d8" stroke-width=".6"/>
            <circle cx="60" cy="56" r=".9" fill="#9aa6b2"/><circle cx="60" cy="66" r=".9" fill="#9aa6b2"/>
            <!-- cuello -->
            <path d="M50 31 L60 40 L54 44 Z M70 31 L60 40 L66 44 Z" fill="#f4f7f9" stroke="#c5ced6" stroke-width=".5"/>
            <!-- moño -->
            <path d="M60 42 L49 37 Q47 42 49 47 Z M60 42 L71 37 Q73 42 71 47 Z" fill="#14181c"/>
            <rect x="57.6" y="39.5" width="4.8" height="5" rx="1.2" fill="#2c343c"/>
            <!-- saco -->
            <path d="M27 36 L46 30 L60 84 L74 30 L93 36 Q99 44 98 60 L96 154 Q60 160 24 154 L22 60 Q21 44 27 36 Z" fill="url(#jk)"/>
            <!-- solapas -->
            <path d="M46 30 L60 84 L54 86 L36 56 L44 50 L38 42 Z" fill="url(#lap)" stroke="#6b7682" stroke-width=".5"/>
            <path d="M74 30 L60 84 L66 86 L84 56 L76 50 L82 42 Z" fill="url(#lap)" stroke="#6b7682" stroke-width=".5"/>
            <!-- abertura del saco -->
            <path d="M60 84 Q58 120 50 156" fill="none" stroke="#56616c" stroke-width=".8"/>
            <!-- botones -->
            <circle cx="62" cy="98" r="2" fill="#0a0c0e" stroke="#7c8894" stroke-width=".6"/>
            <circle cx="61.4" cy="112" r="2" fill="#0a0c0e" stroke="#7c8894" stroke-width=".6"/>
            <!-- pañuelo y bolsillos -->
            <path d="M74 74 L88 72" stroke="#5c6772" stroke-width="1"/>
            <path d="M77 74 L79 67 L81 72 L83 66 L85 73 Z" fill="#e8edf1"/>
            <path d="M30 124 L48 122 M72 122 L90 124" stroke="#5c6772" stroke-width="1"/>
            <!-- brillo -->
            <path d="M30 44 Q26 90 28 150" stroke="#ffffff" stroke-opacity=".08" stroke-width="4" fill="none"/>
          </svg>
          <span class="sans">{{ c.vestimenta.etiqueta_traje }}</span>
        </div>
        <div>
          <svg viewBox="0 26 120 144" class="outfit" aria-hidden="true">
            <defs>
              <linearGradient id="gw" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#2f3e4d"/><stop offset=".3" stop-color="#6d8399"/><stop offset=".55" stop-color="#a9bccd"/><stop offset=".8" stop-color="#5d7287"/><stop offset="1" stop-color="#2a3744"/></linearGradient>
              <linearGradient id="bd" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8ea3b7"/><stop offset="1" stop-color="#4a5d70"/></linearGradient>
            </defs>
            <!-- tirantes -->
            <path d="M42 30 L45 44 M78 30 L75 44" stroke="#4a5d70" stroke-width="1.8" stroke-linecap="round"/>
            <!-- falda -->
            <path d="M47 70 Q36 100 22 140 Q16 156 10 162 Q36 168 60 166 Q84 168 110 162 Q104 156 98 140 Q84 100 73 70 Z" fill="url(#gw)"/>
